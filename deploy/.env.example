# 서버의 /opt/jinfarm/.env 로 복사한 뒤 값을 채운다. (이 파일 자체에는 실제 비밀번호를 넣지 말 것)
# server-setup.sh 가 없는 항목을 추가하고, *_PASSWORD / *_TOKEN 값은 무작위로 생성한다.
APP_IMAGE=ghcr.io/poly-etilen/jin-farm
APP_TAG=latest
APP_PORT=8080

DB_NAME=jinfarm
DB_USER=jinfarm
DB_PASSWORD=change-me

REDIS_PASSWORD=change-me

INFLUX_USERNAME=admin
INFLUX_PASSWORD=change-me
INFLUX_TOKEN=change-me
INFLUX_ORG=jinfarm
INFLUX_BUCKET=sensor
INFLUX_RETENTION=365d
INFLUX_PORT=8086

MQTT_USERNAME=jinfarm-server
MQTT_PASSWORD=change-me
MQTT_PORT=1883
